{
  "version": 1,
  "baseDirectory": "~",
  "projects": {
    "aigc-php": {
      "root": "aigc-php-core",
      "adapter": "php-controller",
      "generatorConfig": "proto/generator.toml",
      "endpointIndex": "proto/navigation.json"
    },
    "node": {
      "root": "node-core",
      "adapter": "typescript-controller",
      "generatorConfig": "proto/generator.toml",
      "endpointIndex": "proto/navigation.json"
    },
    "rust": {
      "root": "rust-core",
      "adapter": "rust-controller",
      "generatorConfig": "proto/generator.toml",
      "endpointIndex": "proto/navigation.json"
    },
    "go": {
      "root": "go-core",
      "adapter": "go-controller",
      "generatorConfig": "proto/generator.toml",
      "endpointIndex": "proto/navigation.json"
    },
    "aigc-vue": {
      "root": "aigc-vue",
      "adapter": "vue-typescript",
      "sourceRoots": ["src/views", "src/partner"],
      "importAliases": {"@/": "src/"},
      "companionExtensions": ["vue", "ts"],
      "backendScope": ["aigc-php", "node", "rust", "go"],
      "gateway": {
        "stripPrefixes": ["/api"],
        "routes": [
          {"prefix": "/route__live_audio", "project": "node"},
          {"prefix": "/route__node_use_shell", "project": "node"},
          {"prefix": "/route__menu_similarity", "project": "node"},
          {"prefix": "/route__mindshow_node_common", "project": "node"},
          {"prefix": "/route__platform_node_core", "project": "node"},
          {"prefix": "/route__node_admin", "project": "node"}
        ],
        "fallback": "ask"
      },
      "requests": [
        {
          "id": "common-ajax",
          "importFrom": "@/utils/common",
          "importName": "default",
          "members": ["do_ajax_async", "do_ajax"],
          "urlArgument": 0
        },
        {
          "id": "partner-request",
          "importFrom": "@/partner/api",
          "importName": "partnerRequest",
          "urlArgument": 0,
          "project": "node"
        }
      ],
      "specProviders": [
        {
          "id": "crud-spec",
          "importGlob": "@/gen/crud_spec/*",
          "urlFields": ["urls.list", "urls.opt"],
          "project": "aigc-php"
        }
      ]
    }
  },
  "links": [
    {
      "source": {"project": "aigc-vue", "file": "src/views/admin/notify/task_list.vue"},
      "endpoints": [
        {"project": "aigc-php", "id": "admin/notify/task_list", "method": "POST"},
        {"project": "aigc-php", "id": "admin/notify/task_opt", "method": "POST"}
      ]
    },
    {
      "source": {"project": "aigc-vue", "file": "src/views/llm_admin/manage/LlmSubmit.vue"},
      "endpoints": [
        {"project": "node", "id": "llm_admin/manage/submit", "method": "POST"}
      ]
    }
  ],
  "interaction": {
    "singleCandidate": "open",
    "multipleCandidates": "completing-read",
    "missingTarget": "explain",
    "recordHistory": "xref"
  }
}
