;;; xcwen-project-jump-index.el --- Endpoint and frontend relationships -*- lexical-binding: t; -*-

(require 'xcwen-project-jump-adapters)
(require 'url-parse)
(defvar xcwen-jump--index-cache (make-hash-table :test #'equal))
(defvar xcwen-jump--source-cache (make-hash-table :test #'equal))
(defvar xcwen-jump--scan-processes nil)
(defvar xcwen-jump--scan-queue nil)
(defvar xcwen-jump--scan-timer nil)
(defvar xcwen-jump--diagnostics nil)
(defvar xcwen-jump--dependencies nil)
(defvar xcwen-jump--collect-dependencies nil)
(defvar xcwen-jump--request-state nil)

(defun xcwen-jump--stamp (file)
  (let ((buffer (find-buffer-visiting file)))
    (if (and buffer (buffer-modified-p buffer))
        (with-current-buffer buffer (list 'buffer buffer (buffer-chars-modified-tick)))
      (let ((attrs (file-attributes file)))
        (list (file-attribute-modification-time attrs) (file-attribute-size attrs))))))

(defun xcwen-jump--index (project)
  (let* ((file (xcwen-jump--file project (alist-get 'endpointIndex (xcwen-jump-project-settings project))))
         (stamp (xcwen-jump--stamp file)) (cached (gethash file xcwen-jump--index-cache)))
    (unless (file-readable-p file)
      (user-error "%s: 缺少 %s，请用新版 proto-gen 生成索引" (xcwen-jump-project-id project) file))
    (when xcwen-jump--collect-dependencies (push (cons file stamp) xcwen-jump--dependencies))
    (if (equal stamp (car cached)) (cdr cached)
      (let* ((data (xcwen-jump--json file)) (entries (alist-get 'endpoints data)) seen)
        (unless (eql (alist-get 'version data) 1) (user-error "%s: 不支持的索引版本" file))
        (dolist (e entries)
          (xcwen-jump--string (alist-get 'id e) "endpoint.id")
          (unless (member (alist-get 'method e) '("GET" "POST" "PUT" "PATCH" "DELETE" "HEAD" "OPTIONS"))
            (user-error "%s: 不支持的 HTTP method" file))
          (let ((key (cons (alist-get 'id e) (alist-get 'method e))))
            (when (member key seen) (user-error "%s: 重复接口 %s" file key)) (push key seen))
          (unless (and (alist-get 'paths e) (cl-every (lambda (s) (and (stringp s) (string-prefix-p "/" s))) (alist-get 'paths e)))
            (user-error "%s: 无效 paths" file))
          (xcwen-jump--file project (alist-get 'proto e))
          (xcwen-jump--file project (alist-get 'file (alist-get 'controller e)))
          (dolist (key '(owner symbol)) (xcwen-jump--string (alist-get key (alist-get 'controller e)) (symbol-name key))))
        (puthash file (cons stamp entries) xcwen-jump--index-cache)
        entries))))

(defun xcwen-jump--ref (project entry reason &optional start end)
  (list :project project :entry entry :reason reason :start start :end end))
(defun xcwen-jump--ref-key (ref)
  (let ((p (plist-get ref :project)) (e (plist-get ref :entry)))
    (list (xcwen-jump-project-workspace p) (xcwen-jump-project-id p) (alist-get 'id e) (alist-get 'method e))))
(defun xcwen-jump--unique-refs (refs)
  (cl-delete-duplicates refs :test (lambda (a b) (equal (xcwen-jump--ref-key a) (xcwen-jump--ref-key b)))))

(defun xcwen-jump--file-links (project file)
  (let (refs)
    (dolist (link xcwen-jump--links)
      (when (and (equal (xcwen-jump-project-workspace project)
                        (xcwen-jump-project-workspace (plist-get link :project)))
                 (equal (file-truename file) (file-truename (plist-get link :file))))
        (dolist (identity (plist-get link :endpoints))
          (let* ((peer (xcwen-jump--peer project (alist-get 'project identity)))
                 (entries (cl-remove-if-not
                           (lambda (e) (and (equal (alist-get 'id e) (alist-get 'id identity))
                                             (or (null (alist-get 'method identity))
                                                 (equal (alist-get 'method e) (alist-get 'method identity)))))
                           (xcwen-jump--index peer))))
            (unless entries (user-error "links 接口不存在: %s %s" (xcwen-jump-project-id peer) (alist-get 'id identity)))
            (dolist (e entries) (push (xcwen-jump--ref peer e "显式 links") refs))))))
    (nreverse refs)))

(defun xcwen-jump--prefix-p (prefix path)
  (or (equal prefix path) (string-prefix-p (concat (string-remove-suffix "/" prefix) "/") path)))

(defun xcwen-jump--url-refs (project raw fixed reason start end &optional method)
  "Resolve RAW without discarding unknown gateway prefixes."
  (let* ((cfg (xcwen-jump-project-settings project)) (gateway (alist-get 'gateway cfg))
         (path (car (split-string (if (string-match-p "\\`https?://" raw)
                                     (url-filename (url-generic-parse-url raw)) raw) "[?#]")))
         selected explicit refs)
    (dolist (prefix (sort (copy-sequence (alist-get 'stripPrefixes gateway))
                          (lambda (a b) (> (length a) (length b)))))
      (when (xcwen-jump--prefix-p prefix path) (setq path (substring path (length prefix)))))
    (let ((route (cl-find-if (lambda (r) (xcwen-jump--prefix-p (alist-get 'prefix r) path))
                             (sort (copy-sequence (alist-get 'routes gateway))
                                   (lambda (a b) (> (length (alist-get 'prefix a)) (length (alist-get 'prefix b))))))))
      (when route
        (setq selected (alist-get 'project route) explicit t
              path (substring path (length (alist-get 'prefix route))))))
    (when (and fixed selected (not (equal fixed selected)))
      (user-error "请求封装 %s 与网关后端 %s 冲突" fixed selected))
    (if (and (not explicit) (string-match-p "\\`/route__" path))
        (push (format "未知网关前缀: %s" raw) xcwen-jump--diagnostics)
      (let ((scope (if (or selected fixed) (list (or selected fixed)) (alist-get 'backendScope cfg))))
        (dolist (id scope)
          (let ((peer (xcwen-jump--peer project id)))
            (dolist (e (xcwen-jump--index peer))
              (when (and (member path (alist-get 'paths e))
                         (or (null method) (equal method (alist-get 'method e))))
                (push (xcwen-jump--ref peer e reason start end) refs))))))
      (when explicit
        (dolist (link (xcwen-jump--file-links project buffer-file-name))
          (when (and (member path (alist-get 'paths (plist-get link :entry)))
                     (not (equal selected (xcwen-jump-project-id (plist-get link :project)))))
            (user-error "显式 links 与请求网关项目冲突: %s" raw)))))
    (nreverse refs)))

(defun xcwen-jump--import-file (project source)
  (let ((aliases (alist-get 'importAliases (xcwen-jump-project-settings project))) file)
    (dolist (alias aliases)
      (let ((prefix (symbol-name (car alias))))
        (when (string-prefix-p prefix source)
          (setq file (xcwen-jump--file project (concat (cdr alias) (substring source (length prefix))))))))
    (when (string-prefix-p "." source)
      (setq file (expand-file-name source (file-name-directory buffer-file-name))))
    (when (and file (file-in-directory-p file (xcwen-jump-project-root project)))
      (cl-find-if #'file-readable-p (list file (concat file ".ts") (concat file ".vue") (concat file "/index.ts"))))))

(defun xcwen-jump--with-source (file function)
  (let ((buffer (find-buffer-visiting file)))
    (if buffer (with-current-buffer buffer (save-restriction (widen) (funcall function)))
      (with-temp-buffer (setq buffer-file-name file) (insert-file-contents file) (funcall function)))))

(defun xcwen-jump--import-matches-p (project source expected)
  "Compare resolved import files, allowing relative paths and configured aliases."
  (or (equal source expected)
      (let ((actual (xcwen-jump--import-file project source))
            (wanted (xcwen-jump--import-file project expected)))
        (and actual wanted (equal (file-truename actual) (file-truename wanted))))))

(defun xcwen-jump--provider-matches-p (project source pattern)
  (or (string-match-p (wildcard-to-regexp pattern) source)
      (let ((actual (xcwen-jump--import-file project source)) wanted)
        (dolist (alias (alist-get 'importAliases (xcwen-jump-project-settings project)))
          (let ((prefix (symbol-name (car alias))))
            (when (string-prefix-p prefix pattern)
              (setq wanted (expand-file-name (concat (cdr alias) (substring pattern (length prefix)))
                                             (xcwen-jump-project-root project))))))
        (and actual wanted (string-match-p (wildcard-to-regexp wanted) actual)))))

(defun xcwen-jump--spec-urls (project binding provider)
  "Read only the imported symbol's literal urls object."
  (let ((file (xcwen-jump--import-file project (nth 1 binding))))
    (when file
      (when xcwen-jump--collect-dependencies
        (push (cons file (xcwen-jump--stamp file)) xcwen-jump--dependencies))
      (xcwen-jump--with-source
       file
       (lambda ()
         (let ((tokens (xcwen-jump--tokens)) object urls result)
           (dotimes (i (length tokens))
             (when (and (equal (xcwen-jump--text tokens i) (nth 2 binding))
                        (xcwen-jump--code-p (aref tokens i))
                        (member (xcwen-jump--text tokens (1- i)) '("const" "let" "var")))
               (let ((j (1+ i)))
                 (while (and (< j (length tokens)) (not (member (xcwen-jump--text tokens j) '("=" ";")))) (setq j (1+ j)))
                 (when (equal (xcwen-jump--text tokens (1+ j)) "{") (setq object (aref tokens (1+ j)))))))
           (when object
             (dotimes (i (length tokens))
               (when (and (equal (xcwen-jump--text tokens i) "urls")
                          (eq (xcwen-jump-token-parent (aref tokens i)) object)
                          (equal (xcwen-jump--text tokens (1+ i)) ":")
                          (equal (xcwen-jump--text tokens (+ i 2)) "{"))
                 (setq urls (aref tokens (+ i 2)))))
             (when urls
               (dotimes (i (length tokens))
                 (when (and (eq (xcwen-jump-token-parent (aref tokens i)) urls)
                            (member (concat "urls." (xcwen-jump--text tokens i)) (alist-get 'urlFields provider))
                            (equal (xcwen-jump--text tokens (1+ i)) ":")
                            (eq (xcwen-jump-token-kind (or (xcwen-jump--tok tokens (+ i 2)) (xcwen-jump--token))) 'string))
                   (push (xcwen-jump--text tokens (+ i 2)) result)))))
           (nreverse result)))))))

(defun xcwen-jump--frontend-refs (project)
  "Extract statically declared requests from the current buffer."
  (let* ((tokens (xcwen-jump--tokens)) (imports (xcwen-jump--imports tokens))
         (cfg (xcwen-jump-project-settings project)) refs)
    (dolist (binding imports)
      (dolist (rule (alist-get 'requests cfg))
        (when (and (xcwen-jump--import-matches-p project (nth 1 binding) (alist-get 'importFrom rule))
                   (equal (nth 2 binding) (alist-get 'importName rule)))
          (dotimes (i (length tokens))
            (when (and (xcwen-jump--code-p (aref tokens i))
                       (equal (xcwen-jump--text tokens i) (car binding))
                       (not (equal (xcwen-jump--text tokens (1- i)) ".")))
              (let* ((members (alist-get 'members rule))
                     (open-index (xcwen-jump--call-open-index tokens (if members (+ i 3) (1+ i))))
                     (open (xcwen-jump--tok tokens open-index)))
                (when (and (or (null members)
                               (and (equal (xcwen-jump--text tokens (1+ i)) ".")
                                    (member (xcwen-jump--text tokens (+ i 2)) members)))
                           (equal (xcwen-jump--text tokens open-index) "(")
                           (xcwen-jump-token-pair open))
                  (let ((j (1+ open-index)) (argument 0) (wanted (or (alist-get 'urlArgument rule) 0)))
                    (while (and (< j (length tokens)) (< argument wanted)
                                (< (xcwen-jump-token-start (aref tokens j)) (xcwen-jump-token-start (xcwen-jump-token-pair open))))
                      (when (and (eq (xcwen-jump-token-parent (aref tokens j)) open)
                                 (equal (xcwen-jump--text tokens j) ",")) (setq argument (1+ argument)))
                      (setq j (1+ j)))
                    (let ((arg (xcwen-jump--tok tokens j)) (next (xcwen-jump--text tokens (1+ j))))
                      (when (and (<= (xcwen-jump-token-start (aref tokens i)) (point))
                                 (<= (point) (xcwen-jump-token-end (xcwen-jump-token-pair open))))
                        (setq xcwen-jump--request-state
                              (if (and arg (eq (xcwen-jump-token-kind arg) 'string) (member next '("," ")")))
                                  'literal 'dynamic)))
                      (if (and (= argument wanted) arg (eq (xcwen-jump-token-kind arg) 'string)
                               (member next '("," ")")))
                          (setq refs (append refs (xcwen-jump--url-refs project (xcwen-jump-token-text arg)
                                                                      (alist-get 'project rule) (alist-get 'id rule)
                                                                      (xcwen-jump-token-start (aref tokens i))
                                                                      (xcwen-jump-token-end (xcwen-jump-token-pair open))
                                                                      (alist-get 'method rule))))
                        (push (format "动态请求无法静态解析: %s" (car binding)) xcwen-jump--diagnostics))))))))))
      (dolist (provider (alist-get 'specProviders cfg))
        (when (and (equal (alist-get 'id provider) "crud-spec") (xcwen-jump--provider-matches-p project (nth 1 binding) (alist-get 'importGlob provider)))
          (let ((urls (xcwen-jump--spec-urls project binding provider)))
            (dotimes (i (length tokens))
              (when (and (xcwen-jump--code-p (aref tokens i))
                         (equal (xcwen-jump--text tokens i) (car binding))
                         (not (equal (xcwen-jump--text tokens (1- i)) "import")))
                (dolist (url urls)
                  (when (and (<= (xcwen-jump-token-start (aref tokens i)) (point))
                             (<= (point) (xcwen-jump-token-end (aref tokens i))))
                    (setq xcwen-jump--request-state 'literal))
                  (setq refs (append refs (xcwen-jump--url-refs project url (alist-get 'project provider) "CRUD spec"
                                                               (xcwen-jump-token-start (aref tokens i))
                                                               (xcwen-jump-token-end (aref tokens i))))))))))))
    (dolist (provider (alist-get 'specProviders cfg))
      (when (and (equal (alist-get 'id provider) "table-mixin")
                 (cl-some (lambda (binding) (xcwen-jump--import-matches-p project (nth 1 binding) (alist-get 'importFrom provider))) imports))
        (dotimes (i (length tokens))
          (when (and (equal (xcwen-jump--text tokens i) "this")
                     (equal (xcwen-jump--text tokens (1+ i)) ".")
                     (equal (xcwen-jump--text tokens (+ i 2)) "table_init")
                     (equal (xcwen-jump--text tokens (+ i 3)) "(")
                     (equal (xcwen-jump--text tokens (+ i 4)) "{"))
            (let* ((object (aref tokens (+ i 4))) (end (xcwen-jump-token-pair object)))
              (when end
                (let ((j (+ i 5)))
                  (while (and (< j (length tokens)) (< (xcwen-jump-token-start (aref tokens j)) (xcwen-jump-token-start end)))
                    (when (and (eq (xcwen-jump-token-parent (aref tokens j)) object)
                               (member (xcwen-jump--text tokens j) (alist-get 'urlFields provider))
                               (equal (xcwen-jump--text tokens (1+ j)) ":")
                               (eq (xcwen-jump-token-kind (or (xcwen-jump--tok tokens (+ j 2)) (xcwen-jump--token))) 'string))
                      (setq refs (append refs (xcwen-jump--url-refs project (xcwen-jump--text tokens (+ j 2)) (alist-get 'project provider)
                                      "table mixin" (xcwen-jump-token-start (aref tokens i)) (xcwen-jump-token-end end)))))
                    (setq j (1+ j))))))))))
    refs))

(defun xcwen-jump--cached-source (project file)
  (let* ((stamp (xcwen-jump--stamp file)) (key (list (xcwen-jump-project-workspace project) file))
         (cached (gethash key xcwen-jump--source-cache)))
    (if (and (equal stamp (car cached))
             (cl-every (lambda (dep) (equal (cdr dep) (xcwen-jump--stamp (car dep)))) (nth 2 cached)))
        (nth 1 cached)
      (let* ((xcwen-jump--dependencies nil) (xcwen-jump--collect-dependencies t)
             (refs (xcwen-jump--with-source file (lambda () (xcwen-jump--frontend-refs project)))))
        (puthash key (list stamp refs (delete-dups xcwen-jump--dependencies)) xcwen-jump--source-cache) refs))))

(defun xcwen-jump--scan-step ()
  (setq xcwen-jump--scan-timer nil)
  (dotimes (_ 10)
    (when xcwen-jump--scan-queue
      (let* ((item (pop xcwen-jump--scan-queue)) (project (car item)) (file (cdr item)))
        (condition-case err (xcwen-jump--cached-source project file)
          (error (push (format "%s: %s" file (error-message-string err)) xcwen-jump--diagnostics))))))
  (when xcwen-jump--scan-queue
    (setq xcwen-jump--scan-timer (run-with-idle-timer 0.1 nil #'xcwen-jump--scan-step))))

(defun xcwen-jump--start-scan ()
  "Enumerate only configured frontend roots asynchronously; never invoke a shell."
  (when (executable-find "rg")
    (dolist (p xcwen-jump--projects)
      (when (equal (xcwen-jump-project-adapter p) "vue-typescript")
        (let* ((project p) (default-directory (xcwen-jump-project-root p))
               (output (generate-new-buffer " *project-jump-files*")))
          (push
           (make-process
            :name "project-jump-index" :buffer output :noquery t
            :command (append '("rg" "--files" "-0" "-g" "*.vue" "-g" "*.ts" "-g" "!*.test.*" "-g" "!node_modules/**" "-g" "!dist/**")
                             (alist-get 'sourceRoots (xcwen-jump-project-settings p)))
            :sentinel
            (lambda (proc _event)
              (when (memq (process-status proc) '(exit signal))
                (when (and (zerop (process-exit-status proc)) (buffer-live-p output))
                  (with-current-buffer output
                    (dolist (rel (split-string (buffer-string) "\0" t))
                      (push (cons project (xcwen-jump--file project rel)) xcwen-jump--scan-queue))))
                (when (buffer-live-p output) (kill-buffer output))
                (setq xcwen-jump--scan-processes (delq proc xcwen-jump--scan-processes))
                (unless xcwen-jump--scan-timer
                  (setq xcwen-jump--scan-timer (run-with-idle-timer 0.1 nil #'xcwen-jump--scan-step))))))
           xcwen-jump--scan-processes))))))

(provide 'xcwen-project-jump-index)
