;;; xcwen-project-jump.el --- Navigate related projects and API sources -*- lexical-binding: t; -*-

(require 'xcwen-project-jump-index)
(require 'xref)
(require 'pp)
(defvar xcwen-jump--startup-timer nil)

(defun xcwen-jump--context ()
  (unless buffer-file-name (user-error "当前 buffer 没有关联文件"))
  (save-restriction
    (widen)
    (let* ((file (file-truename buffer-file-name)) (project (xcwen-jump--project-for-file file))
           (adapter (xcwen-jump-project-adapter project))
           (links (xcwen-jump--file-links project file)) refs role at-point)
      (if (equal adapter "vue-typescript")
          (let* ((xcwen-jump--request-state nil) (all (xcwen-jump--frontend-refs project)) (pos (point)))
            (setq role 'frontend
                  at-point (cl-remove-if-not (lambda (r) (and (<= (plist-get r :start) pos)
                                                             (<= pos (plist-get r :end)))) all)
                  refs (cond (at-point at-point)
                             ((and (eq xcwen-jump--request-state 'dynamic) links) links)
                             (xcwen-jump--request-state nil)
                             (t (or links all))))
            (when (and xcwen-jump--request-state (null refs))
              (setq at-point 'unresolved)
              (push "光标处的请求无法解析，请检查路由/索引；动态请求可配置 links" xcwen-jump--diagnostics)))
        (let ((tokens nil) php-symbol (pos (point))
              (relative (file-relative-name file (xcwen-jump-project-root project))))
          (dolist (entry (xcwen-jump--index project))
            (let* ((ctrl (alist-get 'controller entry))
                   (proto (alist-get 'proto entry))
                   (controller (alist-get 'file ctrl)))
              (cond ((equal relative proto)
                     (setq role 'proto) (push (xcwen-jump--ref project entry "协议文件") refs))
                    ((equal relative controller)
                     (setq role 'controller)
                     (unless tokens
                       (setq tokens (xcwen-jump--tokens))
                       (when (equal adapter "php-controller")
                         (dotimes (i (1- (length tokens)))
                           (when (and (xcwen-jump--code-p (aref tokens i))
                                      (equal (xcwen-jump--text tokens i) "function")
                                      (<= (xcwen-jump-token-start (aref tokens i)) pos))
                             (setq php-symbol (xcwen-jump--text tokens (1+ i)))))))
                     (dolist (range (when (or (not (equal adapter "php-controller"))
                                              (equal php-symbol (alist-get 'symbol ctrl)))
                                      (xcwen-jump--method-ranges tokens adapter (alist-get 'owner ctrl) (alist-get 'symbol ctrl))))
                       (when (and (<= (nth 0 range) pos) (<= pos (nth 1 range))
                                  (not (xcwen-jump--nested-function-p tokens (nth 3 range) pos)))
                         (push (xcwen-jump--ref project entry "Controller 方法") refs)))))))))
      (list :project project :file file :role role :refs (xcwen-jump--unique-refs refs)
            :links links :at-point at-point))))

(defun xcwen-jump--nested-function-p (tokens body pos)
  "Reject a nested declared function containing POS inside BODY."
  (let (nested)
    (dotimes (i (length tokens))
      (let ((tok (aref tokens i)))
        (when (and (> (xcwen-jump-token-start tok) (xcwen-jump-token-start body))
                   (< (xcwen-jump-token-start tok) pos)
                   (xcwen-jump--code-p tok)
                   (member (xcwen-jump-token-text tok) '("function" "fn" "func")))
          (let ((j (1+ i)))
            (while (and (< j (length tokens)) (not (member (xcwen-jump--text tokens j) '("{" ";")))) (setq j (1+ j)))
            (let ((end (and (xcwen-jump--tok tokens j) (xcwen-jump-token-pair (aref tokens j)))))
              (when (and end (< (xcwen-jump-token-start (aref tokens j)) pos)
                         (< pos (xcwen-jump-token-end end))) (setq nested t)))))))
    nested))

(defun xcwen-jump--candidate (ref kind &optional file reason)
  (let* ((project (plist-get ref :project)) (entry (plist-get ref :entry))
         (ctrl (alist-get 'controller entry)))
    (list :project project :entry entry :kind kind
          :file (or file (xcwen-jump--file project (if (eq kind 'proto) (alist-get 'proto entry) (alist-get 'file ctrl))))
          :reason (or reason (plist-get ref :reason)))))

(defun xcwen-jump--same-ref-p (a b)
  (equal (xcwen-jump--ref-key a) (xcwen-jump--ref-key b)))

(defun xcwen-jump--pages (ref)
  (let (pages)
    ;; Seed plausible files on demand, then verify their actual requests.
    ;; Background enumeration is optional for these conventional page paths.
    (dolist (frontend xcwen-jump--projects)
      (when (and (equal (xcwen-jump-project-adapter frontend) "vue-typescript")
                 (equal (xcwen-jump-project-workspace frontend)
                        (xcwen-jump-project-workspace (plist-get ref :project))))
        (dolist (root (alist-get 'sourceRoots (xcwen-jump-project-settings frontend)))
          (dolist (extension '("vue" "ts"))
            (let ((file (xcwen-jump--file frontend
                          (concat (string-remove-suffix "/" root) "/"
                                  (alist-get 'id (plist-get ref :entry)) "." extension))))
              (when (file-readable-p file)
                (xcwen-jump--cached-source frontend file)))))))
    ;; Visiting buffers may contain new requests not yet present in the disk index.
    (dolist (buffer (buffer-list))
      (with-current-buffer buffer
        (when (and buffer-file-name (buffer-modified-p))
          (let ((project (ignore-errors (xcwen-jump--project-for-file buffer-file-name))))
            (when (and project (equal (xcwen-jump-project-adapter project) "vue-typescript"))
              (xcwen-jump--cached-source project buffer-file-name))))))
    (dolist (link xcwen-jump--links)
      (let ((project (plist-get link :project)) (file (plist-get link :file)))
        (when (and (equal (xcwen-jump-project-workspace project)
                          (xcwen-jump-project-workspace (plist-get ref :project)))
                   (cl-some (lambda (r) (xcwen-jump--same-ref-p r ref)) (xcwen-jump--file-links project file)))
          (push (xcwen-jump--candidate ref 'page file "显式反向 links") pages))))
    (maphash
     (lambda (key _cached)
       (let* ((file (nth 1 key))
              (project (cl-find-if (lambda (p) (and (equal (car key) (xcwen-jump-project-workspace p))
                                                   (file-in-directory-p file (xcwen-jump-project-root p)))) xcwen-jump--projects)))
         (when (and project (file-readable-p file)
                    (equal (xcwen-jump-project-workspace project)
                           (xcwen-jump-project-workspace (plist-get ref :project))))
           (when (cl-some (lambda (r) (xcwen-jump--same-ref-p r ref)) (xcwen-jump--cached-source project file))
             (push (xcwen-jump--candidate ref 'page file "请求/spec 反向索引") pages)))))
     xcwen-jump--source-cache)
    pages))

(defun xcwen-jump--companions (context)
  (let* ((project (plist-get context :project)) (file (plist-get context :file))
         (extensions (alist-get 'companionExtensions (xcwen-jump-project-settings project))) result)
    (dolist (ext extensions)
      (let ((target (concat (file-name-sans-extension file) "." ext)))
        (when (and (not (equal file target)) (file-regular-p target))
          (push (list :project project :kind 'companion :file target :reason "同名配套文件") result))))
    result))

(defun xcwen-jump--candidates (context mode)
  (let* ((refs (plist-get context :refs)) (role (plist-get context :role)) candidates)
    (cond
     ((eq mode 'proto)
      (unless (eq role 'proto) (dolist (r refs) (push (xcwen-jump--candidate r 'proto) candidates))))
     ((eq mode 'all)
      (dolist (r refs)
        (push (xcwen-jump--candidate r 'controller) candidates)
        (push (xcwen-jump--candidate r 'proto) candidates)
        (setq candidates (append (xcwen-jump--pages r) candidates))
        (dolist (peer xcwen-jump--projects)
          (when (and (not (equal (xcwen-jump-project-adapter peer) "vue-typescript"))
                     (equal (xcwen-jump-project-workspace peer)
                            (xcwen-jump-project-workspace (plist-get r :project))))
            (dolist (e (xcwen-jump--index peer))
              (when (equal (alist-get 'id e) (alist-get 'id (plist-get r :entry)))
                (let ((other (xcwen-jump--ref peer e "其他后端同逻辑接口")))
                  (push (xcwen-jump--candidate other 'controller) candidates)
                  (push (xcwen-jump--candidate other 'proto) candidates)))))))
      (setq candidates (append (xcwen-jump--companions context) candidates)))
     ((eq role 'frontend)
      (if (or (plist-get context :at-point) (plist-get context :links))
          (dolist (r refs) (push (xcwen-jump--candidate r 'controller) candidates))
        (setq candidates (xcwen-jump--companions context))
        (unless candidates (dolist (r refs) (push (xcwen-jump--candidate r 'controller) candidates)))))
     ((eq role 'controller)
      (dolist (r refs)
        (setq candidates (append (or (xcwen-jump--pages r) (list (xcwen-jump--candidate r 'proto))) candidates))))
     ((eq role 'proto) (dolist (r refs) (push (xcwen-jump--candidate r 'controller) candidates)))
     (t (setq candidates (xcwen-jump--companions context))))
    (cl-delete-duplicates
     (cl-remove-if (lambda (c) (and (equal (file-truename (plist-get c :file)) (plist-get context :file))
                                   (not (eq (plist-get c :kind) 'controller)))) candidates)
     :test (lambda (a b) (equal (list (plist-get a :file) (plist-get a :kind) (plist-get a :entry))
                                (list (plist-get b :file) (plist-get b :kind) (plist-get b :entry)))))))

(defun xcwen-jump--label (candidate)
  (let* ((project (plist-get candidate :project)) (entry (plist-get candidate :entry))
         (ctrl (alist-get 'controller entry)))
    (format "[%s] %s %s %s%s → %s (%s)"
            (xcwen-jump-project-id project) (plist-get candidate :kind)
            (or (alist-get 'method entry) "") (or (alist-get 'id entry) "")
            (if (eq (plist-get candidate :kind) 'controller)
                (format " %s::%s" (alist-get 'owner ctrl) (alist-get 'symbol ctrl)) "")
            (abbreviate-file-name (plist-get candidate :file)) (plist-get candidate :reason))))

(defun xcwen-jump--open (candidate)
  (let ((file (plist-get candidate :file)))
    (unless (file-regular-p file) (user-error "跳转目标不存在，请检查索引: %s" file))
    (xref-push-marker-stack)
    (find-file file)
    (when (eq (plist-get candidate :kind) 'controller)
      (widen)
      (let* ((ctrl (alist-get 'controller (plist-get candidate :entry)))
             (ranges (xcwen-jump--method-ranges (xcwen-jump--tokens)
                                               (xcwen-jump-project-adapter (plist-get candidate :project))
                                               (alist-get 'owner ctrl) (alist-get 'symbol ctrl))))
        (unless (and (= (length ranges) 1)
                     (<= (nth 0 (car ranges)) (point))
                     (<= (point) (nth 1 (car ranges))))
          (goto-char (if (= (length ranges) 1) (nth 2 (car ranges)) (point-min))))
        (unless (= (length ranges) 1)
          (message "已打开文件，但无法唯一定位 %s::%s，请检查方法或重新生成索引"
                   (alist-get 'owner ctrl) (alist-get 'symbol ctrl)))))))

(defun xcwen-jump--run (mode &optional prefer-proto)
  (setq xcwen-jump--diagnostics nil)
  (let* ((context (xcwen-jump--context)) (candidates (xcwen-jump--candidates context mode)))
    (unless candidates
      (user-error "%s" (if (and (eq mode 'proto) (eq (plist-get context :role) 'proto)) "当前已是协议文件"
                         (or (car xcwen-jump--diagnostics) "没有关联目标；请在接口方法/请求处调用，或配置 links"))))
    (xcwen-jump--open
     (if (and (not prefer-proto) (= (length candidates) 1)) (car candidates)
       (let* ((choices (sort (mapcar (lambda (c) (cons (xcwen-jump--label c) c)) candidates)
                             (lambda (a b) (string-lessp (car a) (car b))))))
         (let* ((preferred (and prefer-proto
                                (cl-find-if (lambda (pair)
                                  (and (eq (plist-get (cdr pair) :kind) 'proto)
                                       (eq (plist-get (cdr pair) :project) (plist-get context :project)))) choices)))
                  (default (car (or preferred (and prefer-proto
                                (cl-find-if (lambda (pair) (eq (plist-get (cdr pair) :kind) 'proto)) choices))))))
           (cdr (assoc (completing-read "关联目标: " choices nil t nil nil default) choices))))))))

(defun xcwen-jump-related (all)
  "Jump to the related source; with prefix ALL, choose among all relationships."
  (interactive "P") (xcwen-jump--run (if all 'all 'related)))
(defun xcwen-jump-proto ()
  "Jump to the current endpoint's protocol in its own backend."
  (interactive) (xcwen-jump--run 'all t))

(defun xcwen-jump-describe-context ()
  "Explain current endpoint identities, candidates and unresolved expressions."
  (interactive)
  (setq xcwen-jump--diagnostics nil)
  (let* ((context (xcwen-jump--context)) (candidates (xcwen-jump--candidates context 'all))
         (text (with-temp-buffer
                 (insert (format "项目: %s\n配置: %s\n文件: %s\n角色: %s\n后台扫描: %s 个进程，%s 个待处理文件\n\n"
                                 (xcwen-jump-project-id (plist-get context :project))
                                 (xcwen-jump-project-workspace (plist-get context :project))
                                 (plist-get context :file) (plist-get context :role)
                                 (length xcwen-jump--scan-processes) (length xcwen-jump--scan-queue)))
                 (dolist (c candidates) (insert (xcwen-jump--label c) "\n"))
                 (dolist (d (delete-dups xcwen-jump--diagnostics)) (insert "\n未解析: " d))
                 (buffer-string))))
    (with-help-window "*Project jump context*" (princ text))))

(defun xcwen-jump-reload ()
  "Reload workspace configuration and rebuild frontend relations asynchronously."
  (interactive)
  (xcwen-jump--load-config)
  (dolist (process xcwen-jump--scan-processes)
    (set-process-sentinel process #'ignore)
    (let ((buffer (process-buffer process))) (delete-process process) (when (buffer-live-p buffer) (kill-buffer buffer))))
  (when xcwen-jump--scan-timer (cancel-timer xcwen-jump--scan-timer))
  (setq xcwen-jump--scan-processes nil xcwen-jump--scan-queue nil xcwen-jump--scan-timer nil xcwen-jump--diagnostics nil)
  (clrhash xcwen-jump--index-cache) (clrhash xcwen-jump--source-cache)
  (xcwen-jump--start-scan)
  (when (called-interactively-p 'interactive) (message "已加载 %d 个项目；后台构建前端关系" (length xcwen-jump--projects))))

(defun xcwen-jump--after-save ()
  (when (and buffer-file-name xcwen-jump--projects)
    (let ((project (ignore-errors (xcwen-jump--project-for-file buffer-file-name))))
      (when (and project (equal (xcwen-jump-project-adapter project) "vue-typescript"))
        (unless (or xcwen-jump--scan-processes xcwen-jump--scan-queue)
          (xcwen-jump--start-scan))))))
(add-hook 'after-save-hook #'xcwen-jump--after-save)

(defun xcwen-jump-initialize ()
  "Schedule configuration loading without blocking Spacemacs startup."
  (unless xcwen-jump--startup-timer
    (setq xcwen-jump--startup-timer
          (run-with-idle-timer
           1 nil (lambda ()
                   (setq xcwen-jump--startup-timer nil)
                   (condition-case err (xcwen-jump-reload)
                     (error (message "项目跳转初始化: %s" (error-message-string err)))))))))

(provide 'xcwen-project-jump)
;;; xcwen-project-jump.el ends here
