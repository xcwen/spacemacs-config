;;; xcwen-project-jump-config.el --- Declarative jump workspaces -*- lexical-binding: t; -*-

(require 'cl-lib)
(require 'json)
(require 'subr-x)

(defgroup xcwen-jump nil "Related project files." :group 'tools)
(defconst xcwen-jump--directory
  (file-name-directory (or load-file-name buffer-file-name)))
(defcustom xcwen-jump-workspace-files
  (let ((local (expand-file-name "~/.config/emacs/project-jump/workspaces/aigc.json")))
    (list (if (file-exists-p local) local
            (expand-file-name "examples/project-jump.workspace.json" xcwen-jump--directory))))
  "JSON workspace files. Relative project roots use their baseDirectory."
  :type '(repeat file))
(cl-defstruct xcwen-jump-project id root adapter settings workspace)
(defvar xcwen-jump--projects nil)
(defvar xcwen-jump--links nil)
(defvar xcwen-jump--loaded-files nil)

(defun xcwen-jump--json (file)
  (condition-case err
      (with-temp-buffer
        (insert-file-contents file)
        (json-parse-buffer :object-type 'alist :array-type 'list
                           :null-object nil :false-object nil))
    (error (user-error "跳转 JSON %s: %s" file (error-message-string err)))))

(defun xcwen-jump--keys (value allowed where)
  (unless (and (listp value) (cl-every #'consp value))
    (user-error "%s 必须为 JSON 对象" where))
  (dolist (pair value)
    (unless (memq (car pair) allowed)
      (user-error "%s: 未知字段 %s" where (car pair)))))

(defun xcwen-jump--string (value where)
  (unless (and (stringp value) (not (string-empty-p value)))
    (user-error "%s 必须为非空字符串" where))
  value)

(defun xcwen-jump--file (project relative)
  "Resolve RELATIVE inside PROJECT, rejecting escaping paths and symlinks."
  (xcwen-jump--string relative "项目内路径")
  (when (file-name-absolute-p relative)
    (user-error "项目内路径必须为相对路径: %s" relative))
  (let ((file (expand-file-name relative (xcwen-jump-project-root project))))
    (unless (file-in-directory-p file (xcwen-jump-project-root project))
      (user-error "路径超出项目 %s: %s" (xcwen-jump-project-id project) relative))
    file))

(defun xcwen-jump--project (id &optional workspace)
  (or (cl-find-if (lambda (p) (and (equal id (xcwen-jump-project-id p))
                                  (or (null workspace)
                                      (equal workspace (xcwen-jump-project-workspace p)))))
                  xcwen-jump--projects)
      (user-error "未注册跳转项目: %s" id)))

(defun xcwen-jump--peer (project id)
  (xcwen-jump--project id (xcwen-jump-project-workspace project)))

(defun xcwen-jump--load-config ()
  "Validate all workspaces before replacing the current project graph."
  (let (projects links)
    (dolist (file xcwen-jump-workspace-files)
      (let* ((file (expand-file-name file)) (cfg (xcwen-jump--json file))
             (base (expand-file-name (or (alist-get 'baseDirectory cfg) ".")
                                     (file-name-directory file)))
             (ids (mapcar (lambda (x) (symbol-name (car x))) (alist-get 'projects cfg))))
        (xcwen-jump--keys cfg '(version baseDirectory projects links interaction) file)
        (unless (eql (alist-get 'version cfg) 1) (user-error "%s: 不支持的配置版本" file))
        (unless ids (user-error "%s: projects 不能为空" file))
        (let ((interaction (alist-get 'interaction cfg)))
          (xcwen-jump--keys interaction '(singleCandidate multipleCandidates missingTarget recordHistory) "interaction")
          (dolist (rule '((singleCandidate . "open") (multipleCandidates . "completing-read")
                          (missingTarget . "explain") (recordHistory . "xref")))
            (when (and (alist-get (car rule) interaction)
                       (not (equal (alist-get (car rule) interaction) (cdr rule))))
              (user-error "不支持的交互设置: %s" (car rule)))))
        (dolist (entry (alist-get 'projects cfg))
          (let* ((id (symbol-name (car entry))) (v (cdr entry))
                 (root (file-name-as-directory
                        (file-truename (expand-file-name
                                        (xcwen-jump--string (alist-get 'root v) id) base))))
                 (adapter (alist-get 'adapter v)))
            (xcwen-jump--keys v '(root adapter generatorConfig endpointIndex sourceRoots importAliases companionExtensions backendScope gateway requests specProviders) id)
            (unless (member adapter '("php-controller" "typescript-controller" "rust-controller" "go-controller" "vue-typescript"))
              (user-error "%s: 未知 adapter %s" id adapter))
            (unless (file-directory-p root) (user-error "%s: 项目目录不存在 %s" id root))
            (when (cl-find root projects :key #'xcwen-jump-project-root :test #'equal)
              (user-error "项目根重复注册: %s" root))
            (dolist (ref (append (alist-get 'backendScope v)
                                (mapcar (lambda (r) (alist-get 'project r))
                                        (alist-get 'routes (alist-get 'gateway v)))
                                (delq nil (mapcar (lambda (r) (alist-get 'project r))
                                                 (append (alist-get 'requests v) (alist-get 'specProviders v))))))
              (unless (member ref ids) (user-error "%s 引用未注册项目 %s" id ref)))
            (let ((p (make-xcwen-jump-project :id id :root root :adapter adapter :settings v :workspace file)))
              (if (equal adapter "vue-typescript")
                  (progn
                    (unless (and (alist-get 'sourceRoots v) (alist-get 'backendScope v))
                      (user-error "%s: 需要 sourceRoots 和 backendScope" id))
                    (dolist (dir (alist-get 'sourceRoots v))
                      (unless (file-directory-p (xcwen-jump--file p dir)) (user-error "%s: sourceRoot 不存在 %s" id dir)))
                    (let ((gateway (alist-get 'gateway v)))
                      (xcwen-jump--keys gateway '(stripPrefixes routes fallback) "gateway")
                      (when (and (alist-get 'fallback gateway) (not (equal (alist-get 'fallback gateway) "ask")))
                        (user-error "gateway.fallback 仅支持 ask"))
                      (dolist (prefix (append (alist-get 'stripPrefixes gateway)
                                             (mapcar (lambda (r) (alist-get 'prefix r)) (alist-get 'routes gateway))))
                        (unless (and (stringp prefix) (string-prefix-p "/" prefix) (> (length prefix) 1)
                                     (not (string-suffix-p "/" prefix)))
                          (user-error "无效网关前缀: %s" prefix))))
                    (dolist (request (alist-get 'requests v))
                      (xcwen-jump--keys request '(id importFrom importName members urlArgument project method) "requests")
                      (dolist (key '(id importFrom importName)) (xcwen-jump--string (alist-get key request) (symbol-name key)))
                      (unless (natnump (or (alist-get 'urlArgument request) 0)) (user-error "urlArgument 必须为非负整数")))
                    (dolist (provider (alist-get 'specProviders v))
                      (xcwen-jump--keys provider '(id importGlob importFrom urlFields project) "specProviders")
                      (unless (member (alist-get 'id provider) '("crud-spec" "table-mixin"))
                        (user-error "未知 spec provider: %s" (alist-get 'id provider)))
                      (xcwen-jump--string (or (alist-get 'importGlob provider) (alist-get 'importFrom provider)) "provider source")
                      (unless (cl-every (lambda (s) (member s '("urls.list" "urls.opt" "get_list_url" "opt_url"))) (alist-get 'urlFields provider))
                        (user-error "crud-spec 仅支持 urls.list/urls.opt"))))
                (xcwen-jump--file p (alist-get 'endpointIndex v)))
              (push p projects))))
        (dolist (link (alist-get 'links cfg))
          (let* ((source (alist-get 'source link))
                 (project (cl-find-if (lambda (p) (and (equal file (xcwen-jump-project-workspace p))
                                                       (equal (alist-get 'project source) (xcwen-jump-project-id p)))) projects)))
            (unless project (user-error "links 引用未知源项目"))
            (dolist (endpoint (alist-get 'endpoints link))
              (unless (member (alist-get 'project endpoint) ids) (user-error "links 引用未知目标项目"))
              (xcwen-jump--string (alist-get 'id endpoint) "endpoint.id"))
            (push (list :project project :file (xcwen-jump--file project (alist-get 'file source))
                        :endpoints (alist-get 'endpoints link)) links)))))
    (setq xcwen-jump--projects (nreverse projects)
          xcwen-jump--links (nreverse links)
          xcwen-jump--loaded-files (copy-sequence xcwen-jump-workspace-files))))

(defun xcwen-jump--ensure-config ()
  (unless (equal xcwen-jump--loaded-files xcwen-jump-workspace-files)
    (xcwen-jump--load-config)))

(defun xcwen-jump--project-for-file (file)
  (xcwen-jump--ensure-config)
  (let ((file (file-truename file)))
    (or (car (sort (cl-remove-if-not
                    (lambda (p) (file-in-directory-p file (xcwen-jump-project-root p)))
                    (copy-sequence xcwen-jump--projects))
                   (lambda (a b) (> (length (xcwen-jump-project-root a))
                                    (length (xcwen-jump-project-root b))))))
        (user-error "文件未归属已注册项目: %s" file))))

(provide 'xcwen-project-jump-config)
;;; xcwen-project-jump-config.el ends here
