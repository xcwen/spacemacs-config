;;; xcwen-project-jump-adapters.el --- Source contexts without evaluation -*- lexical-binding: t; -*-

(require 'xcwen-project-jump-config)
(cl-defstruct (xcwen-jump-token (:constructor xcwen-jump--token)) text kind start end pair parent)

(defun xcwen-jump--lex-region ()
  "Lex current source, keeping strings separate and pairing delimiters.
Comments are omitted. Template expressions are deliberately opaque."
  (save-excursion
    (goto-char (point-min))
    (let (out stack)
      (while (< (point) (point-max))
        (cond
         ((looking-at "[ \t\r\n]+") (goto-char (match-end 0)))
         ((looking-at "//[^\n]*\\|/\\*\\(?:.\\|\n\\)*?\\*/") (goto-char (match-end 0)))
         ((and (string-suffix-p ".rs" (or buffer-file-name ""))
               (looking-at "r\\(#+\\)?\""))
          (let* ((start (point)) (hashes (or (match-string-no-properties 1) ""))
                 (begin (match-end 0)) (end (progn (goto-char begin) (search-forward (concat "\"" hashes) nil t))))
            (push (xcwen-jump--token :text (buffer-substring-no-properties begin (if end (- end (1+ (length hashes))) (point-max)))
                                    :kind 'string :start start :end (or end (point-max)) :parent (car stack)) out)
            (goto-char (or end (point-max)))))
         ((and (string-suffix-p ".php" (or buffer-file-name ""))
               (eq (char-after) ?#) (not (eq (char-after (1+ (point))) ?\[))) (forward-line 1))
         ((and (eq (char-after) ?/)
               (string-match-p "\\.\\(?:ts\\|vue\\)\\'" (or buffer-file-name ""))
               (or (null out) (member (xcwen-jump-token-text (car out))
                                      '("(" "=" "," ":" "return" "!" "?" "[" "{" ">"))))
          (let ((start (point)) in-class done)
            (forward-char)
            (while (and (< (point) (point-max)) (not done) (not (eq (char-after) ?\n)))
              (cond ((eq (char-after) ?\\) (forward-char) (when (< (point) (point-max)) (forward-char)))
                    ((eq (char-after) ?\[) (setq in-class t) (forward-char))
                    ((eq (char-after) ?\]) (setq in-class nil) (forward-char))
                    ((and (eq (char-after) ?/) (not in-class)) (forward-char) (setq done t))
                    (t (forward-char))))
            (skip-chars-forward "a-z")
            (push (xcwen-jump--token :text "<regexp>" :kind 'string :start start :end (point) :parent (car stack)) out)))
         ((or (memq (char-after) '(?\" ?`))
              (and (eq (char-after) ?')
                   (not (and (string-suffix-p ".rs" (or buffer-file-name ""))
                             (looking-at "'[[:alpha:]_][[:alnum:]_]*")
                             (not (eq (char-after (match-end 0)) ?'))))))
          (let ((start (point)) (quote (char-after)) text done)
            (forward-char)
            (while (and (< (point) (point-max)) (not done))
              (cond ((eq (char-after) ?\\)
                     (push (char-after) text) (forward-char)
                     (when (< (point) (point-max)) (push (char-after) text) (forward-char)))
                    ((eq (char-after) quote) (setq done t) (forward-char))
                    (t (push (char-after) text) (forward-char))))
            (push (xcwen-jump--token :text (apply #'string (nreverse text))
                                    :kind (if (or (not done) (and (eq quote ?`) (member ?$ text))) 'dynamic 'string)
                                    :start start :end (point) :parent (car stack)) out)))
         (t
          (let* ((start (point))
                 (word (looking-at "\\(?:r#\\)?[[:alpha:]_$][[:alnum:]_$]*\\|[0-9]+"))
                 (text (if word (prog1 (match-string-no-properties 0) (goto-char (match-end 0)))
                         (prog1 (string (char-after)) (forward-char))))
                 (token (xcwen-jump--token :text text :kind 'code :start start :end (point) :parent (car stack))))
            (cond ((member text '("(" "[" "{")) (push token stack))
                  ((member text '(")" "]" "}"))
                   (when (and stack (equal text (cdr (assoc (xcwen-jump-token-text (car stack))
                                                                           '(("(" . ")") ("[" . "]") ("{" . "}"))))))
                     (setf (xcwen-jump-token-pair token) (car stack)
                           (xcwen-jump-token-pair (car stack)) token)
                     (pop stack))))
            (push token out)))))
      (vconcat (nreverse out)))))

(defun xcwen-jump--tokens ()
  "Tokenize scripts only in Vue SFCs, otherwise the current source region."
  (if (not (string-suffix-p ".vue" (or buffer-file-name ""))) (xcwen-jump--lex-region)
    (save-excursion
      (goto-char (point-min))
      (let (parts)
        (while (re-search-forward "<script\\b[^>]*>" nil t)
          (let ((start (point)))
            (when (re-search-forward "</script[ \t]*>" nil t)
              (let ((end (match-beginning 0)))
                (push (save-restriction (narrow-to-region start end) (xcwen-jump--lex-region)) parts)))))
        (apply #'vconcat (nreverse parts))))))

(defun xcwen-jump--tok (tokens n)
  (and (>= n 0) (< n (length tokens)) (aref tokens n)))
(defun xcwen-jump--text (tokens n)
  (let ((token (xcwen-jump--tok tokens n))) (and token (xcwen-jump-token-text token))))
(defun xcwen-jump--code-p (token)
  (and token (eq (xcwen-jump-token-kind token) 'code)))
(defun xcwen-jump--call-open-index (tokens index)
  "Skip optional TypeScript type arguments before a call's opening parenthesis."
  (let ((i index) (depth 0))
    (when (equal (xcwen-jump--text tokens i) "<")
      (setq depth 1 i (1+ i))
      (while (and (> depth 0) (< i (length tokens)))
        (cond ((equal (xcwen-jump--text tokens i) "<") (setq depth (1+ depth)))
              ((equal (xcwen-jump--text tokens i) ">") (setq depth (1- depth))))
        (setq i (1+ i))))
    i))
(defun xcwen-jump--brace-parent (token)
  (let ((p (xcwen-jump-token-parent token)))
    (while (and p (not (equal (xcwen-jump-token-text p) "{")))
      (setq p (xcwen-jump-token-parent p))) p))

(defun xcwen-jump--declaration-start (tokens index go)
  (let ((i index))
    (when go
      (setq i (1- (cl-position (xcwen-jump-token-pair (aref tokens (1- index))) tokens :test #'eq))))
    (while (member (xcwen-jump--text tokens (1- i))
                   '("public" "private" "protected" "static" "async" "function" "fn" "pub" "unsafe" "final" "abstract" "override" "&"))
      (setq i (1- i)))
    (let ((start (xcwen-jump-token-start (aref tokens i))))
      (save-excursion
        (goto-char start)
        (if (string-match-p "\\`[ \t]*\\'" (buffer-substring-no-properties (line-beginning-position) start))
            (line-beginning-position) start)))))

(defun xcwen-jump--method-ranges (tokens adapter owner symbol)
  "Return method ranges belonging to OWNER, excluding nested functions."
  (let (owners result)
    (dotimes (i (length tokens))
      (when (and (xcwen-jump--code-p (aref tokens i))
                 (member (xcwen-jump--text tokens i) '("class" "impl")))
        (let ((j (1+ i)) (found nil) trait)
          (while (and (< j (length tokens)) (not (member (xcwen-jump--text tokens j) '("{" ";"))))
            (when (equal (xcwen-jump--text tokens j) owner) (setq found t))
            (when (equal (xcwen-jump--text tokens j) "for") (setq trait t))
            (setq j (1+ j)))
          (when (and found (not trait)
                     (or (equal (xcwen-jump--text tokens i) "impl")
                         (equal (xcwen-jump--text tokens (1+ i)) owner))
                     (equal (xcwen-jump--text tokens j) "{")) (push (aref tokens j) owners)))))
    (dotimes (i (length tokens))
      (let* ((token (aref tokens i)) (params (xcwen-jump--tok tokens (1+ i)))
             (previous (xcwen-jump--text tokens (1- i)))
             (receiver (xcwen-jump--tok tokens (1- i)))
             (go (and (equal adapter "go-controller") (equal previous ")")
                      (xcwen-jump-token-pair receiver)))
             (valid (if go
                        (let* ((open (xcwen-jump-token-pair receiver))
                               (idx (cl-position open tokens :test #'eq)))
                          (and (equal (xcwen-jump--text tokens (1- idx)) "func")
                               (equal (xcwen-jump--text tokens (- i 2)) owner)
                               (null (xcwen-jump--brace-parent token))))
                      (and (memq (xcwen-jump--brace-parent token) owners)
                           (cond ((equal adapter "php-controller") (equal previous "function"))
                                 ((equal adapter "rust-controller") (equal previous "fn"))
                                 ((equal adapter "typescript-controller")
                                  (not (member previous '("." "function" "=" "return")))))))))
        (when (and valid (xcwen-jump--code-p token) (equal (xcwen-jump-token-text token) symbol)
                   (equal (xcwen-jump--text tokens (1+ i)) "(") (xcwen-jump-token-pair params))
          (let ((j (1+ (cl-position (xcwen-jump-token-pair params) tokens :test #'eq))))
            (while (and (< j (length tokens)) (not (member (xcwen-jump--text tokens j) '("{" ";"))))
              (setq j (1+ j)))
            (let* ((body (xcwen-jump--tok tokens j)) (end (and body (xcwen-jump-token-pair body))))
              (when (and end (equal (xcwen-jump-token-text body) "{"))
                (push (list (xcwen-jump--declaration-start tokens i go)
                            (xcwen-jump-token-end end) (xcwen-jump-token-start token) body)
                      result)))))))
    result))

(defun xcwen-jump--imports (tokens)
  "Return local import bindings as (LOCAL SOURCE EXPORT)."
  (let (result)
    (dotimes (i (length tokens))
      (when (and (xcwen-jump--code-p (aref tokens i)) (equal (xcwen-jump--text tokens i) "import"))
        (let ((j (1+ i)) names source)
          (while (and (< j (length tokens)) (not (member (xcwen-jump--text tokens j) '("from" ";"))))
            (push (xcwen-jump--text tokens j) names) (setq j (1+ j)))
          (when (and (equal (xcwen-jump--text tokens j) "from")
                     (eq (xcwen-jump-token-kind (or (xcwen-jump--tok tokens (1+ j)) (xcwen-jump--token))) 'string))
            (setq source (xcwen-jump--text tokens (1+ j)) names (nreverse names))
            (unless (member (car names) '("{" "*" "type"))
              (push (list (pop names) source "default") result))
            (while names
              (let ((name (pop names)))
                (unless (member name '("{" "}" "," "type"))
                  (let ((local name))
                    (when (equal (car names) "as") (pop names) (setq local (pop names)))
                    (push (list local source name) result)))))))))
    result))

(provide 'xcwen-project-jump-adapters)
;;; xcwen-project-jump-adapters.el ends here
